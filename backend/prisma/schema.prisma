datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String?
  name             String?
  createdAt        DateTime  @default(now())
  audits           Audit[]

  // Level 8 Password Recovery Columns
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
}

model Audit {
  id              String   @id @default(uuid())
  userId          String?
  language        String
  sourceCode      String
  timeComplexity  String
  spaceComplexity String
  explanation     String
  issuesCount     Int
  issuesJson      String
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}